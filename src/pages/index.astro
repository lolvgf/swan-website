---
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HonoreeCard from '../components/HonoreeCard.astro';
import EventCard from '../components/EventCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getSite, getHonorees } from '../lib/site';

const site = await getSite();
const page = (await getEntry('pages', 'home'))!;
const { Content } = await render(page);

const honorees = await getHonorees();
const latestYear = Math.max(...honorees.map((h) => h.data.year));
const latest = honorees.filter((h) => h.data.year === latestYear);
const woy = latest.filter((h) => h.data.award === 'woman-of-the-year');
const rising = latest.filter((h) => h.data.award === 'rising-swan');
const lifetime = latest.filter((h) => h.data.award === 'lifetime-achievement');

const today = new Date(); today.setUTCHours(0, 0, 0, 0);
const events = (await getCollection('events')).filter((e) => e.data.date >= today).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const nextEvent = events.find((e) => e.data.featured) ?? events[0];
const NextEventContent = nextEvent ? (await render(nextEvent)).Content : null;

const scholars = await getCollection('scholars');
const yearsActive = new Date().getFullYear() - 1984;
---
<Base description={site.description} image={page.data.heroImage}>
  <!-- HERO -->
  <section class="home-hero">
    <img class="home-hero__bg" src={page.data.heroImage ?? '/images/hero-tulips.jpg'} alt="" fetchpriority="high" />
    <div class="container home-hero__inner">
      <span class="eyebrow">Skagit Women's Alliance and Network · Since 1984</span>
      <h1>{page.data.title}</h1>
      <p class="lead">{page.data.subtitle}</p>
      <div class="btn-row">
        <a class="btn btn--coral" href="/nominate">Nominate a woman</a>
        {site.ticketsUrl && <a class="btn btn--light" href={site.ticketsUrl} target="_blank" rel="noopener">{site.ticketsLabel ?? 'Get tickets'}</a>}
        <a class="btn btn--ghost home-hero__ghost" href="/about">Our story →</a>
      </div>
    </div>
  </section>

  <!-- STATS + MISSION -->
  <section class="section section--tight">
    <div class="container split">
      <div class="prose">
        <span class="eyebrow">Our mission</span>
        <h2>Recognizing and supporting women of achievement in Skagit County</h2>
        <Content />
        <a href="/about" class="btn btn--outline">About SWAN</a>
      </div>
      <div class="stats">
        <div class="stat"><span class="stat__n">{yearsActive}+</span><span class="stat__l">years honoring Skagit women</span></div>
        <div class="stat"><span class="stat__n">{honorees.length}</span><span class="stat__l">award recipients since 1985</span></div>
        <div class="stat"><span class="stat__n">{scholars.length}</span><span class="stat__l">scholarships awarded</span></div>
        <div class="stat"><span class="stat__n">$2,000+</span><span class="stat__l">awarded every year</span></div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section section--blush">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Our awards</span>
        <h2>Three ways we celebrate extraordinary women</h2>
        <p class="lead">Every October, during National Business Women's Week, SWAN honors women whose work is changing Skagit County.</p>
      </div>
      <div class="grid grid--3">
        <a class="card card--link" href="/women-of-the-year">
          <div class="card__icon">W</div>
          <h3>Women of the Year</h3>
          <p>Recognizing extraordinary, recognizable contributions in Professional Achievement, Mentorship of Women, Transformative Leadership, and Community Engagement.</p>
          <p><strong>Learn more →</strong></p>
        </a>
        <a class="card card--link" href="/rising-swan">
          <div class="card__icon">R</div>
          <h3>Rising Swan</h3>
          <p>Celebrating emerging leaders who are growing in their professional achievement, mentorship, community engagement, and leadership.</p>
          <p><strong>Learn more →</strong></p>
        </a>
        <a class="card card--link" href="/lifetime-achievement">
          <div class="card__icon">L</div>
          <h3>Lifetime Achievement</h3>
          <p>Honoring women who have dedicated their lives and careers to serving others and lifting up the women of our community.</p>
          <p><strong>Learn more →</strong></p>
        </a>
      </div>
    </div>
  </section>

  <!-- LATEST RECIPIENTS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{latestYear} award recipients</span>
        <h2>Meet this year's honorees</h2>
        <p class="lead">Congratulations to the women recognized at the {latestYear} Women of the Year Awards Banquet.</p>
      </div>
      <div class="grid recipients">
        {woy.map((h) => <HonoreeCard showAward {...h.data} />)}
        {rising.map((h) => <HonoreeCard showAward {...h.data} />)}
        {lifetime.map((h) => <HonoreeCard showAward {...h.data} />)}
      </div>
      <div class="btn-row mt-3">
        <a class="btn btn--primary" href="/previous-woy">See all previous honorees</a>
        <a class="btn btn--ghost" href="/women-of-the-year">About the awards →</a>
      </div>
    </div>
  </section>

  <!-- NEXT EVENT -->
  {nextEvent && (
    <section class="section section--blush">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Upcoming</span>
          <h2>Save the date</h2>
        </div>
        <EventCard {...nextEvent.data}>{NextEventContent && <NextEventContent />}</EventCard>
        <p class="mt-2"><a href="/events">All events →</a></p>
      </div>
    </section>
  )}

  <!-- SCHOLARSHIP -->
  <section class="section">
    <div class="container split">
      <div class="frame"><img src="/images/scholarship.jpg" alt="SWAN scholarship recipients" loading="lazy" /></div>
      <div>
        <span class="eyebrow">SWAN Scholarship</span>
        <h2>Empowering dedicated women in Skagit County</h2>
        <p class="lead">Each year the SWAN Scholarship awards a minimum of $2,000 to two or more women who live or work in Skagit County. Applications are accepted year-round.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/swan-scholarship">Apply for a scholarship</a>
          <a class="btn btn--outline" href={site.scholarshipDonateUrl ?? site.donateUrl} target="_blank" rel="noopener">Give to the fund</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="It takes a village." text="Sponsor the Women of the Year Banquet, volunteer with the board, or make a gift. Every contribution helps us honor Skagit County women.">
    <a class="btn btn--light" href="/be-a-sponsor">Become a sponsor</a>
    <a class="btn btn--coral" href="/donate">Donate</a>
  </CtaBand>
</Base>

<style>
  .home-hero { position: relative; min-height: min(84vh, 760px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .home-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(63, 13, 42, 0.25), rgba(63, 13, 42, 0.55) 45%, rgba(63, 13, 42, 0.92)); }
  .home-hero__inner { position: relative; z-index: 1; padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem); max-width: 820px; }
  .home-hero .eyebrow { color: #ffb3d0; }
  .home-hero h1 { color: #fff; font-size: clamp(2.5rem, 6vw, 4.4rem); }
  .home-hero .lead { color: #f6dbe7; font-size: clamp(1.05rem, 1.6vw, 1.3rem); }
  .home-hero__ghost { color: #fff; }
  .home-hero .btn-row { margin-top: 1.8rem; }

  .recipients { grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .stat { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem; box-shadow: var(--shadow-sm); }
  .stat__n { display: block; font-family: var(--font-display); font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 700; color: var(--berry); line-height: 1; }
  .stat__l { display: block; margin-top: 0.4rem; color: var(--muted); font-size: 0.92rem; }
</style>
