---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import YearList from '../components/YearList.astro';
import HonoreeCard from '../components/HonoreeCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getHonorees } from '../lib/site';

const page = (await getEntry('pages', 'lifetime-achievement'))!;
const { Content } = await render(page);
const items = await getHonorees('lifetime-achievement');
const humanitarian = await getHonorees('humanitarian');
const latestYear = items[0]?.data.year;
const latest = items.filter((h) => h.data.year === latestYear);
const previous = items.filter((h) => h.data.year !== latestYear);
---
<Base title={page.data.title} description={page.data.subtitle}>
  <PageHero eyebrow="Awards" title={page.data.title} subtitle={page.data.subtitle}>
    <div class="btn-row"><a class="btn btn--primary" href="/nominate">Nominate a Lifetime Achievement honoree</a></div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div class="prose">
        <Content />
        <h2>Eligibility</h2>
        <p>The nominee must live or work in Skagit County and actively contribute to the community they represent. The nominee must be able to attend the SWAN Woman of the Year Banquet & Awards Ceremony, typically held on the third Thursday in October at the Swinomish Casino & Lodge from 5 to 8 pm.</p>
      </div>
      {latest.length > 0 && (
        <div>
          <span class="eyebrow">{latestYear} recipient{latest.length > 1 ? 's' : ''}</span>
          <div class="grid">{latest.map((h) => <HonoreeCard {...h.data} />)}</div>
        </div>
      )}
    </div>
  </section>

  <section class="section section--blush">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Honor roll</span><h2>Previous Lifetime Achievement recipients</h2></div>
      <YearList items={previous} />
      {humanitarian.length > 0 && (
        <div class="mt-3">
          <h3>Humanitarian Award</h3>
          <YearList items={humanitarian} />
        </div>
      )}
    </div>
  </section>

  <CtaBand title="Honor a lifetime of service." text="Lifetime Achievement nominations are accepted year-round.">
    <a class="btn btn--light" href="/nominate">Nominate her</a>
  </CtaBand>
</Base>
