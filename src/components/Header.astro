---
import type { SiteSettings } from '../lib/site';
interface Props { site: SiteSettings }
const { site } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Menú de navegación. Para añadir o quitar enlaces, edita esta lista.
const nav = [
  {
    label: 'Women of the Year', href: '/women-of-the-year',
    children: [
      { label: 'Nominate', href: '/nominate' },
      { label: 'Current recipients', href: '/women-of-the-year' },
      { label: 'Previous Women of the Year', href: '/previous-woy' },
      { label: 'Rising Swan', href: '/rising-swan' },
      { label: 'Lifetime Achievement', href: '/lifetime-achievement' },
      { label: 'Be a sponsor', href: '/be-a-sponsor' },
    ],
  },
  { label: 'Scholarship', href: '/swan-scholarship' },
  { label: 'Events', href: '/events' },
  {
    label: 'Get involved', href: '/get-involved',
    children: [
      { label: 'Volunteer & board', href: '/get-involved' },
      { label: 'Donate', href: '/donate' },
      { label: 'Be a sponsor', href: '/be-a-sponsor' },
    ],
  },
  {
    label: 'About', href: '/about',
    children: [
      { label: 'About SWAN', href: '/about' },
      { label: 'In Memoriam', href: '/in-memoriam' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
{site.announcement && (
  <div class="announce">
    {site.announcement}
    {site.announcementLink && <a href={site.announcementLink}>{site.announcementLinkLabel ?? 'Learn more'} →</a>}
  </div>
)}
<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${site.fullName} home`}>
      <img src="/images/logo.png" alt={site.fullName} width="190" height="71" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" id="nav-toggle">
      <span class="nav-toggle__bar"></span><span class="nav-toggle__bar"></span><span class="nav-toggle__bar"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-children': item.children, 'is-active': isActive(item.href) || item.children?.some(c => isActive(c.href)) }]}>
            {item.children ? (
              <>
                <button class="nav__link nav__link--btn" aria-expanded="false">
                  {item.label} <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} class:list={{ 'is-active': isActive(c.href) }}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="nav__link" href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <div class="nav__cta">
        <a href="/donate" class="btn btn--outline btn--sm">Donate</a>
        <a href="/nominate" class="btn btn--primary btn--sm">Nominate</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: rgba(255, 250, 246, 0.92); backdrop-filter: saturate(160%) blur(10px); border-bottom: 1px solid var(--line); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 78px; }
  .brand img { width: clamp(140px, 16vw, 190px); height: auto; }
  .nav { display: flex; align-items: center; gap: 1.2rem; }
  .nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.2rem; }
  .nav__item { position: relative; }
  .nav__link { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.55rem 0.8rem; border-radius: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-size: 0.95rem; background: none; border: 0; font-family: inherit; cursor: pointer; }
  .nav__link:hover, .nav__item.is-active > .nav__link { color: var(--berry); background: var(--blush); }
  .sub { list-style: none; margin: 0; padding: 0.5rem; position: absolute; top: calc(100% + 6px); left: 0; min-width: 240px; background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s, transform .15s, visibility .15s; }
  .sub a { display: block; padding: 0.55rem 0.8rem; border-radius: 8px; color: var(--ink); text-decoration: none; font-size: 0.93rem; font-weight: 500; }
  .sub a:hover, .sub a.is-active { background: var(--blush); color: var(--berry); }
  .nav__item.has-children:hover .sub, .nav__item.has-children:focus-within .sub, .nav__item.has-children.open .sub { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav__cta { display: flex; gap: 0.5rem; }
  .nav-toggle { display: none; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 12px; background: #fff; flex-direction: column; justify-content: center; align-items: center; gap: 5px; cursor: pointer; }
  .nav-toggle__bar { width: 20px; height: 2px; background: var(--plum); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1000px) {
    .nav-toggle { display: flex; }
    .nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; padding: 0.8rem var(--gutter) 1.2rem; gap: 0.8rem; display: none; box-shadow: var(--shadow); max-height: calc(100vh - 80px); overflow: auto; }
    .nav.open { display: flex; }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__link { width: 100%; justify-content: space-between; padding: 0.8rem 0.6rem; font-size: 1.02rem; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; display: none; padding: 0 0 0.4rem 0.8rem; }
    .nav__item.open .sub { display: block; }
    .nav__item.has-children:hover .sub { display: none; }
    .nav__item.has-children.open .sub, .nav__item.has-children.open:hover .sub { display: block; }
    .nav__cta { justify-content: stretch; }
    .nav__cta .btn { flex: 1; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  document.querySelectorAll('.nav__link--btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const li = btn.closest('.nav__item');
      const isOpen = li?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav__item')) document.querySelectorAll('.nav__item.open').forEach((li) => li.classList.remove('open'));
  });
</script>
