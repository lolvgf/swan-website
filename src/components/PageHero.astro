---
interface Props { eyebrow?: string; title: string; subtitle?: string; image?: string }
const { eyebrow, title, subtitle, image } = Astro.props;
---
<section class:list={['hero', { 'hero--image': image }]}>
  {image && <img class="hero__bg" src={image} alt="" loading="eager" />}
  <div class="container hero__inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {subtitle && <p class="lead">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(3rem, 8vw, 5.5rem); background: var(--blush); overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: auto -10% -60% auto; width: 60vw; max-width: 720px; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(224, 80, 58, 0.18), transparent 70%); pointer-events: none; }
  .hero__inner { position: relative; max-width: 780px; }
  .hero--image { color: #fff; padding-block: clamp(4rem, 12vw, 8rem); }
  .hero--image .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero--image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(63, 13, 42, 0.9) 10%, rgba(122, 21, 70, 0.7) 55%, rgba(63, 13, 42, 0.35)); }
  .hero--image .hero__inner { z-index: 1; }
  .hero--image h1 { color: #fff; }
  .hero--image .lead { color: #f6dbe7; }
  .hero--image .eyebrow { color: #ffb3d0; }
  .hero :global(.btn-row) { margin-top: 1.6rem; }
</style>
